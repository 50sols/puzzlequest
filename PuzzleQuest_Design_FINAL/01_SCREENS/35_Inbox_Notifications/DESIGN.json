    "types": [
      "system",
      "rewards",
      "achievements",
      "progress",
      "account_security",
      "support",
      "events"
    ],
    "ordinary_retention_days": 90,
    "security_retention_days": 180,
    "events_disabled_v1": true,
    "player_states": [
      "loading",
      "empty",
      "unread",
      "read",
      "offline_queued_read",
      "marked_all",
      "error",
      "expired_target",
      "push_permission_denied"
    ],
    "push_navigation": "verify published target and viewer ownership; otherwise stay/open Inbox",
    "brand": "app icon set in compiled iOS/Android app, mockup typographic only"
  },
  "pn01_pn04_final_policy": {
    "reference": "02_DESIGN/PUSH_NOTIFICATION_CONTRACT.json",
    "noncritical_push_max_in_rolling_24h": 2,
    "local_quiet_hours": "22:00–08:00 IANA player timezone",
    "critical_security_can_bypass_only_when_necessary": true,
    "time_zone_unknown": "inbox_available_but_no_normal_scheduled_push",
    "push_settings_off_does_not_disable_inbox": true,
