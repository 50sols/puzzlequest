    "connection_failed": "show_retry_stay_no_progress_loss",
    "token_validation_pending": "disable_submit_keep_origin_and_guest_progress",
    "verification_failed": "stay_offer_retry_no_local_login_claim",
    "verified": "server_issues_session_then_merge_guest_only_after_confirmed_transaction",
    "configuration_unavailable": "hide_or_disable_google_action_with_explanation_no_fake_success",
    "web_client_id_public_reference_only": "02_DESIGN/GOOGLE_OAUTH_DESIGN_CONTRACT.json",
    "no_apple_login": true
  }
