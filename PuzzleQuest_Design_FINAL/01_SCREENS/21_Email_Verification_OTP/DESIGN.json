  "code_policies": {
    "code_length": 6,
    "ttl_seconds": 600,
    "resend_cooldown_seconds": 60,
    "max_attempts_per_code": 5,
    "max_resends_per_15_min": 3,
    "max_resends_per_24h": 10,
    "new_code_invalidates_old": true,
    "repeated_failed_code_lockout_seconds": 900,
