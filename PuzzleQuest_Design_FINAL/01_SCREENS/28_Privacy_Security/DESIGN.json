  "reference_policy": "Art composition and existing visible scope only. LAYOUT.svg and rect_dp define final component geometry; screenshot values and system bars are not UI assets.",
  "layout_preview": "01_SCREENS/28_Privacy_Security/LAYOUT.svg",
  "presentation": "screen",
  "return_policy": {
    "system_back": "return_to_origin",
    "origin_context": "Keep caller screen, selected level/difficulty, attempt and scroll position",
    "fallback": "Welcome_Entry"
  },
  "signed_devices_contract": {
    "existing_screen": 28,
    "subview_not_new_screen": true,
    "columns": [
      "device_name",
      "device_type",
      "android_ios",
      "last_activity_at",
      "session_status",
      "is_current_device"
    ],
    "actions": [
      "logout_one",
      "logout_other_devices"
    ],
    "require_confirmation": true,
    "recent_auth_or_reverify": [
      "password",
      "otp",
      "google"
    ],
    "server_invalidation_immediate": true,
    "offline_client": "revoke_next_contact_keep_local_pending_progress_and_block_protected_requests"
  },
  "data_export_contract": {
    "existing_screen": 28,
    "format": "zip",
    "included": [
      "account_profile",
      "preferences",
      "world_level_progress",
      "best_star_time",
      "scores_coins_ledger",
      "achievements_badges_trophies",
      "rewards_purchases",
      "available_inbox",
      "consent_log",
      "support_tickets",
      "available_device_session_summary"
    ],
    "files": [
      "json",
      "csv",
      "readme"
    ],
    "excluded": [
      "password_hashes",
      "session_keys",
      "otp",
      "backend_secrets"
    ],
    "states": [
      "request",
      "reauth",
      "queued",
      "building",
      "ready",
      "expired",
      "failed_retry"
    ],
    "target_ready_hours": 72,
    "max_days_or_shorter_law": 30,
    "private_link_ttl_days": 7,
    "email_attachment": false
  },
  "privacy_defaults": {
    "nonessential_analytics": false,
    "personalized_ads": false,
    "marketing_notifications": false,
    "optional_tracking": false,
    "optional_consent": false,
    "default_privacy": "private",
    "legal_agreement_not_optional_opt_in": true,
    "consent_audit": [
      "document_version",
      "timestamp_utc",
      "choices"
    ],
    "legal_text_status": "awaiting qualified legal counsel and owner publication approval",
    "legal_pages_host": "https://puzzlequest.50sols.com (requires TLS verification)"
  },
  "notification_category_settings": {
    "existing_privacy_subview": true,
    "categories": "within existing Screen28/40 setting subview, no new player page; never turn on marketing by granting OS permission",
    "master": "see screen12",
    "marketing_default": false
  },
  "pn01_pn04_final_policy": {
    "reference": "02_DESIGN/PUSH_NOTIFICATION_CONTRACT.json",
    "noncritical_push_max_in_rolling_24h": 2,
    "local_quiet_hours": "22:00–08:00 IANA player timezone",
    "critical_security_can_bypass_only_when_necessary": true,
    "time_zone_unknown": "inbox_available_but_no_normal_scheduled_push",
    "push_settings_off_does_not_disable_inbox": true,
    "no_marketing_in_V1": true
  }
}
