  },
  "reference_policy": "Art composition and existing visible scope only. LAYOUT.svg and rect_dp define final component geometry; screenshot values and system bars are not UI assets. Legacy screenshot counts/currencies (+100, +120, +500, Gems) are NOT approved product values. No new Gems UI is supplied; dynamic approved values win. Legacy screenshot counts/currencies (+100, +120, +500, Gems) are NOT approved product values. No new Gems UI is supplied; dynamic approved values win.",
  "layout_preview": "01_SCREENS/06_Puzzle_Gameplay/LAYOUT.svg",
  "flow": {
    "on_last_piece": "Level_Complete",
    "on_back": "Pause_Menu"
  },
  "presentation": "screen",
  "return_policy": {
    "system_back": "return_to_origin",
    "origin_context": "Keep caller screen, selected level/difficulty, attempt and scroll position",
    "fallback": "Home_My_Village"
  },
  "art_policy": "Canonical master/thumbnail from the selected level governs displayed puzzle art. Original reference screenshot is composition-only and is not a promise of identical pixels to the packaged master. Never mix art from different levels or sizes.",
  "approved_product_rules": {
    "source": "02_DESIGN/APPROVED_PRODUCT_RULES.json",
    "applicable_policies": [
      "rating",
      "leaderboard",
      "missions"
    ],
    "design_rule": "Stage-specific countdown and elapsed star thresholds in APPROVED_PRODUCT_RULES; no V1 Extra Time. Shuffle via Pause screen 15; Full Image explicit paid 30s / verified ad 10s choice in existing screen 13.",
    "approved_through": "Q21"
  },
  "dynamic_content_policy_ref": "02_DESIGN/CONTENT_PUBLISHING_CONTRACT.json",
